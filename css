/* Swap these tokens for your identity kit (palette + fonts) next week. */
:root {
  --bg: #eef0f2;
  --ink: #16202a;
  --muted: #5a6672;
  --accent: #2f4bff;

  --font-display: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
  --font-body: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #12181e;
    --ink: #e8ecef;
    --muted: #93a0ab;
    --accent: #8ea0ff;
  }
}

*, *::before, *::after { box-sizing: border-box; }

html, body { height: 100%; margin: 0; }

body {
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  line-height: 1.5;
  display: grid;
  align-items: end;
  padding: clamp(1.25rem, 5vw, 4rem);
  padding-top: max(clamp(1.25rem, 5vw, 4rem), env(safe-area-inset-top));
  padding-bottom: max(clamp(1.25rem, 5vw, 4rem), env(safe-area-inset-bottom));
}

main { max-width: 46rem; }

h1 {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(3rem, 12vw, 8rem);
  line-height: 0.95;
  letter-spacing: -0.03em;
  margin: 0 0 1.5rem;
}

/* The one memorable moment: a rule that draws itself once on load. */
h1::after {
  content: "";
  display: block;
  height: 3px;
  width: 100%;
  margin-top: 1.25rem;
  background: var(--accent);
  transform-origin: left;
  animation: draw 900ms cubic-bezier(.2, .7, .2, 1) both;
}

@keyframes draw { from { transform: scaleX(0); } }

.claim {
  font-size: clamp(1.05rem, 2.4vw, 1.35rem);
  max-width: 34rem;
  margin: 0 0 2rem;
}

.status {
  color: var(--muted);
  font-size: 0.95rem;
  margin: 0;
}

@media (prefers-reduced-motion: reduce) {
  h1::after { animation: none; }
}
